<?xml version="1.0" encoding="utf-8"?>
<!-- A7, mockups В1 + В3: the week with its days and the days since the last workout (tap — «Ритм»),
     the next plan (tap — the plan before «Начать»). Texts and colors are set by Widgets.java. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:tint="#FBF8F2" android:scaleType="fitXY" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">

        <LinearLayout android:id="@+id/w_week" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="НЕДЕЛЯ" android:textSize="11sp" android:fontFamily="monospace" android:textStyle="bold"
                android:letterSpacing="0.08" android:textColor="#5F584D" />
                    <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1 из 2" android:textSize="26sp" android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" android:textColor="#17140F" />
                </LinearLayout>
                <LinearLayout android:id="@+id/w_ago_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_clock" android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_widget_clock" android:tint="#5F584D" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_ago" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="5dp" android:text="3 дня назад" android:textSize="13sp"
                android:fontFamily="sans-serif-medium" android:textColor="#5F584D" />
        </LinearLayout>
            </LinearLayout>
            <ImageView android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </LinearLayout>

        <FrameLayout android:id="@+id/w_plan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView android:id="@+id/w_panel" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_panel" android:tint="#17140F" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/w_next_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Следующая" android:textSize="12sp" android:textColor="#CFC6B6" />
                    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Ноги / грудь / руки" android:textSize="15sp" android:fontFamily="sans-serif-black"
                        android:maxLines="1" android:ellipsize="end" android:textColor="#F2EDE4" />
                </LinearLayout>
                <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="10dp">
                    <ImageView android:id="@+id/w_play_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/widget_play_bg" android:tint="#FF5A1F" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/w_play" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="center" android:src="@drawable/ic_widget_play" android:tint="#17140F" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
