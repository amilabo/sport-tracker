{
  "name": "sport-tracker",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:colors": "node scripts/check-colors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "gen:descriptions": "node scripts/gen-descriptions.mjs",
    "gen:substitutes": "node scripts/gen-substitutes.mjs",
    "check": "npm run check:colors && npm run check:contrast",
    "prebuild": "npm run check",
    "build": "next build && node scripts/build-pwa.mjs",
    "build:android": "node scripts/build-android.mjs",
    "apk": "node scripts/build-android.mjs --release",
    "apk:debug": "node scripts/build-android.mjs --apk",
    "start": "npx --yes serve@14 out",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "idb": "^8.0.4",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
